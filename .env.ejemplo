# Copia este archivo como .env y completa los valores.
# .env esta en .gitignore: no se sube al repositorio y no debe salir del equipo.

# ---- Fishken (stock de bodega)
FISHKEN_USER=
FISHKEN_PWD=

# ---- Postgres (Supabase)
# Rol motor_bloqueos, NUNCA la clave de servicio: el motor no puede escribir
# sobre detenciones, decisiones ni criterios, y esa es la proteccion.
# Usa el Session pooler; la conexion directa es solo IPv6 y no resuelve desde
# equipos sin IPv6. El usuario lleva el project ref pegado con un punto:
#   postgresql://motor_bloqueos.<project-ref>:<clave>@<host>:5432/postgres
# Si la clave tiene @ / : o #, codificalos como %40 %2F %3A %23
BLOQUEOS_DB_URL=

# ---- Rutas, solo si cambian de lugar
# BLOQUEOS_DIR=
# BLOQUEOS_DIR_LAB=
# BLOQUEOS_DIR_MP=
